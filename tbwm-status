#!/bin/sh
# tbwm bar status: wifi, bluetooth, sound + clock.
# Used with tbwm's (set-status-cmd ...). Icons are Nerd Font (Font Awesome)
# glyphs; requires the bar font to be a Nerd Font (e.g. JetBrainsMono Nerd Font).
# Keep this script fast: tbwm runs it once per second.

# Icons as UTF-8 octals (POSIX printf-safe, glyphs are private-use-area chars)
ICON_WIFI=$(printf '\357\207\253')          # wifi
ICON_WIFI_NOCONN=$(printf '\357\232\253')   # wifi (no connection)
ICON_BT=$(printf '\357\212\223')            # bluetooth
ICON_VOL_OFF=$(printf '\357\200\246')       # volume off / muted
ICON_VOL_DOWN=$(printf '\357\200\247')      # volume low
ICON_VOL_UP=$(printf '\357\200\250')        # volume high

s=""

# --- WiFi (NetworkManager) ---
if [ "$(nmcli -t -f WIFI radio 2>/dev/null)" = "enabled" ]; then
    sig="$(nmcli -t -f IN-USE,SIGNAL dev wifi 2>/dev/null | sed -n 's/^\*:\([0-9][0-9]*\).*/\1/p' | head -1)"
    if [ -n "$sig" ]; then
        w="$ICON_WIFI"    # connected (signal: $sig%)
    else
        w="$ICON_WIFI_NOCONN"   # radio on, no connection
    fi
else
    w=""                          # radio off
fi
s="$s$w"

# --- Bluetooth (rfkill: on/off only, no connected devices) ---
if rfkill list bluetooth 2>/dev/null | grep -q 'hci' &&
   ! rfkill list bluetooth 2>/dev/null | grep -q "Soft blocked: yes"; then
    b="$ICON_BT"
else
    b=""
fi
s="$s$b"

# --- Sound (PipeWire) ---
vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
if [ -z "$vol" ]; then
    sp=""
else
    case "$vol" in
        *MUTED*) sp="$ICON_VOL_OFF" ;;
        *)
            pct="$(printf '%s' "$vol" | sed -n 's/.*Volume: \([0-9.]*\).*/\1/p')"
            intv="${pct%.*}"
            decv="${pct#*.}"
            v="$((intv * 100 + ${decv%${decv#??}}))"
            if [ "$v" -le 0 ]; then
                sp="$ICON_VOL_OFF"
            elif [ "$v" -le 33 ]; then
                sp="$ICON_VOL_DOWN"
            else
                sp="$ICON_VOL_UP"
            fi
            ;;
    esac
fi
s="$s$sp"

# --- Clock ---
printf '%s  %s\n' "$s" "$(date '+%I:%M:%S %p')"
