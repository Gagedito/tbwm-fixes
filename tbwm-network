#!/bin/sh
# List WiFi networks and Bluetooth devices for tbwm's network menu.
# Output: Category<TAB>Group=TARGET<TAB>Action<TAB>command[<TAB>needspass], one per line.
# The menu shows every network/device as its own sub-topic (group); selecting one
# shows its actions (Conectar / Desconectar / Olvidar, depending on state).
# WiFi: detects the active network manager (connman or NetworkManager).
# Bluetooth: powered on + brief scan; connect/disconnect/forget by MAC.

# Quote a string for use inside single quotes in a shell command.
q() {
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
}

# --- WiFi (category: Wifi) ---
if pgrep -x connmand >/dev/null 2>&1; then
    connmanctl enable wifi >/dev/null 2>&1
    connmanctl scan wifi >/dev/null 2>&1

    connmanctl services 2>/dev/null | while IFS= read -r line; do
        [ -n "$line" ] || continue
        id=$(printf '%s' "$line" | awk '{print $NF}')
        [ -n "$id" ] || continue
        rest=$(printf '%s' "$line" | sed "s/[[:space:]]*${id}[[:space:]]*$//")
        case "$id" in
            wifi_*_psk|wifi_*_wep) need=1;;
            *) need=0;;
        esac
        case "$rest" in
            *"*"*) conn=1
                   name=$(printf '%s' "$rest" | awk '{$1=""; sub(/^ +/,""); print}');;
            *)     conn=0
                   name=$(printf '%s' "$rest" | sed 's/^[[:space:]]*//');;
        esac
        [ -n "$name" ] || continue

        nameq=$(q "$name")
        printf 'Wifi\t%s' "$nameq"
        if [ "$conn" = "1" ]; then
            printf '\tDesconectar %s\tconnmanctl disconnect %s\n' "$nameq" "$id"
        else
            if [ "$need" = "1" ]; then
                exec_ps="sh -c 'connmanctl config \"\$1\" --passphrase \"\$3\" --save && connmanctl connect \"\$1\"' _ $id"
                printf '\tConectar a %s\t%s\t1\n' "$nameq" "$exec_ps"
            else
                printf '\tConectar a %s\tconnmanctl connect %s\n' "$nameq" "$id"
            fi
        fi
        printf 'Wifi\t%s\tOlvidar %s\tconnmanctl remove %s\n' "$nameq" "$nameq" "$id"
    done
elif [ "$(nmcli -t -f RUNNING general status 2>/dev/null)" = "running" ]; then
    savedw=""
    while IFS=: read -r prof type; do
        [ "$type" = "802-11-wireless" ] || continue
        [ -n "$prof" ] || continue
        savedw="$savedw
$prof"
    done <<EOF
$(nmcli -t -f NAME,TYPE connection show 2>/dev/null)
EOF
    active="$(nmcli -t -f NAME connection show --active 2>/dev/null)"

    printf '%s\n' "$savedw" | while IFS= read -r prof; do
        [ -n "$prof" ] || continue
        pq=$(q "$prof")
        if printf '%s\n' "$active" | grep -qxF "$prof"; then
            printf 'Wifi\t%s\tDesconectar %s\tnmcli connection down '\''%s'\''\n' "$pq" "$pq" "$pq"
        else
            printf 'Wifi\t%s\tConectar a %s\tnmcli connection up '\''%s'\''\n' "$pq" "$pq" "$pq"
        fi
        printf 'Wifi\t%s\tOlvidar %s\tnmcli connection delete '\''%s'\''\n' "$pq" "$pq" "$pq"
    done

    seen="$savedw"
    nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | sort -r | while IFS=: read -r inuse ssid sig sec; do
        [ -n "$ssid" ] || continue
        if printf '%s\n' "$seen" | grep -qxF "$ssid"; then
            continue
        fi
        seen="$seen
$ssid"
        ssq=$(q "$ssid")
        need=0
        [ -n "$sec" ] && need=1
        printf 'Wifi\t%s\tConectar a %s (%s%%)\tnmcli dev wifi connect '\''%s'\''\t%s\n' "$ssq" "$ssq" "$sig" "$ssq" "$need"
    done
else
    printf 'Wifi\tInfo\t[WiFi] ni connman ni NetworkManager activos\tsh -c '\''echo activa: sudo sv up connmand (connman) o NetworkManager'\''\n'
fi

# --- Bluetooth (category: Bluetooth) ---
if command -v bluetoothctl >/dev/null 2>&1; then
    bluetoothctl power on >/dev/null 2>&1
    timeout 10 bluetoothctl scan on >/dev/null 2>&1 &
    scan_pid=$!
    sleep 8
    kill "$scan_pid" 2>/dev/null
    wait "$scan_pid" 2>/dev/null

    paired="$(bluetoothctl devices Paired 2>/dev/null)"
    connected="$(bluetoothctl devices Connected 2>/dev/null)"
    devices="$(bluetoothctl devices 2>/dev/null)"
    seen=""
    if [ -n "$devices" ]; then
        printf '%s\n' "$devices" | while read -r _ mac name; do
            [ -n "$mac" ] || continue
            name=$(printf '%s' "$name" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g')
            [ -n "$name" ] || name="(sin nombre)"
            if printf '%s\n' "$seen" | grep -qF "$mac"; then
                continue
            fi
            seen="$seen
$mac"
            nq=$(q "$name")
            if printf '%s\n' "$connected" | grep -qF "$mac"; then
                printf 'Bluetooth\t%s\tDesconectar %s\tbluetoothctl disconnect %s\n' "$nq" "$nq" "$mac"
                printf 'Bluetooth\t%s\tOlvidar %s\tbluetoothctl remove %s\n' "$nq" "$nq" "$mac"
            elif printf '%s\n' "$paired" | grep -qF "$mac"; then
                printf 'Bluetooth\t%s\tConectar a %s\tbluetoothctl connect %s\n' "$nq" "$nq" "$mac"
                printf 'Bluetooth\t%s\tOlvidar %s\tbluetoothctl remove %s\n' "$nq" "$nq" "$mac"
            else
                printf 'Bluetooth\t%s\tConectar a %s\tbluetoothctl pair %s; bluetoothctl trust %s; bluetoothctl connect %s\n' "$nq" "$nq" "$mac" "$mac" "$mac"
            fi
        done
    else
        printf 'Bluetooth\tInfo\t[BT] Sin dispositivos cerca (reintenta)\tsh -c '\''echo escanea con: bluetoothctl scan on'\''\n'
    fi
else
    printf 'Bluetooth\tInfo\t[BT] instala bluez-utils (bluetoothctl)\tsh -c '\''echo instala: sudo pacman -S bluez bluez-utils'\''\n'
fi