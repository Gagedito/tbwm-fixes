#!/bin/sh
# Launch the waywallen wallpaper daemon + layer-shell presenter under tbwm.
#
# waywallen (instalado como Flatpak) genera el fondo dinamico; el binario
# waywallen-layer-shell lo presenta al compositor via zwlr_layer_shell_v1 +
# linux-dmabuf + Vulkan WSI.
#
# Degradacion a proposito:
#   * Si waywallen NO esta instalado -> no hace nada (exit 0). Sin esperas,
#     sin consumo de memoria ni spam en el log: el fondo queda por defecto
#     (negro o el swaybg/waly que el usuario configure en on-startup).
#   * Si waywallen esta instalado pero falta el presentador -> aviso corto.
#   * Idempotente: mata instancias previas y deja una sola.

set -u

LOG="${XDG_RUNTIME_DIR:-/tmp}/tbwm-waywallen.log"
SOCK="${XDG_RUNTIME_DIR:-/tmp}/waywallen/display.sock"
APPID="org.waywallen.waywallen"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >>"$LOG"; }
now()  { date +%s; }

log "tbwm-waywallen: starting (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-none})"

# --- 0) waywallen instalado? Sino, no hacer nada ---------------------------
if ! command -v flatpak >/dev/null 2>&1 \
   || ! flatpak list --app 2>/dev/null | grep -q "$APPID"; then
    log "waywallen ($APPID) no esta instalado; fondo por defecto. Para activar: flatpak install flathub $APPID + waywallen-layer-shell"
    exit 0
fi
if [ ! -x "$HOME/.local/bin/waywallen-layer-shell" ]; then
    log "waywallen instalado pero falta $HOME/.local/bin/waywallen-layer-shell; fondo por defecto"
    exit 1
fi

# --- clean up previous instances -------------------------------------------
# Comm names are capped at 15 chars in Linux, so match by full path too.
pkill -x waywallen 2>/dev/null
pkill -x waywallen-ui 2>/dev/null
pkill -f 'waywallen-layer-shell' 2>/dev/null
pkill -f 'bin/waywallen-layer' 2>/dev/null
sleep 1

# --- 1) daemon sin UI (Flatpak). --no-ui: solo el fondo, sin ventana. Para
#    abrir la interfaz a mano: flatpak run org.waywallen.waywallen
nohup flatpak run --branch=stable --command=waywallen "$APPID" \
    --no-ui >>"$LOG" 2>&1 &

# --- wait for the daemon's UDS socket --------------------------------------
i=0
while [ ! -S "$SOCK" ] && [ "$i" -lt 40 ]; do
    sleep 1
    i=$((i + 1))
done
if [ ! -S "$SOCK" ]; then
    log "waywallen: ERROR socket no aparece tras ${i}s; abriendo interfaz para depurar: flatpak run $APPID"
    exit 1
fi
log "daemon socket ready at $SOCK"

# --- 2) layer-shell presenter (vulkan WSI sobre eDP-1/..) -------------------
nohup "$HOME/.local/bin/waywallen-layer-shell" >>"$LOG" 2>&1 &
log "layer-shell presenter launched"

log "tbwm-wallpaper: ok"