+	if (sym >= 0x20 && sym <= 0x7e &&
+	    launcher_input_len < (int)sizeof(launcher_input) - 1) {
+		launcher_input[launcher_input_len++] = (char)sym;
+		launcher_input[launcher_input_len] = '\0';
+		launcher_selection = 0;
