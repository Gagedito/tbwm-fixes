+int
+timingtimer(void *data)
+{
+	/* Report CPU timing statistics every 500ms */
+	fprintf(stderr, "[TIMING TICK]\n");
+	fflush(stderr);
+	timing_report();
+	wl_event_source_timer_update(timing_timer, 500);
+	return 0;
+}
