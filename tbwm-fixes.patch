+    # Merge newly discovered devices (from the scan output) into the list so
+    # "Buscar dispositivos" shows devices found during this scan, not only the
+    # ones the daemon already remembered. Later scan emits "[NEW] Device
+    # AA:BB:.. NAME" (and "[NEW] Controller ..." for the adapter). Stale
+    # remembered devices produce no [NEW] line during discovery, so they drop
+    # out of the category automatically. A device only appears under "Buscar
+    # dispositivos" when the current scan actually reported it.
+    if [ -s "$btout" ]; then
