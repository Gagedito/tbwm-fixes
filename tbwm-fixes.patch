+                has_connected=1
+                printf 'Bluetooth\tConectado\t%s\tDesconectar\tbluetoothctl disconnect %s\n' "$nq" "$mac"
+                printf 'Bluetooth\tConectado\t%s\tOlvidar\tbluetoothctl remove %s\n' "$nq" "$mac"
+            elif printf '%s\n' "$paired" | grep -qF "$mac"; then
+                has_paired=1
+                printf 'Bluetooth\tEmparejados\t%s\tConectar\tbluetoothctl connect %s\n' "$nq" "$mac"
+                printf 'Bluetooth\tEmparejados\t%s\tOlvidar\tbluetoothctl remove %s\n' "$nq" "$mac"
+            else
+                # Only show "Buscar dispositivos" for devices seen in the
+                # CURRENT scan; stale remembered devices that are no longer in
+                # range (or no longer visible) would stay forever in the list.
+                if ! grep -qxF "$mac" "$scanmacs"; then
+                    continue
+                fi
+                has_discovered=1
+                printf 'Bluetooth\tBuscar dispositivos\t%s\tConectar\t%s\tBTPAIR\n' "$nq" "$mac"
+            fi
+        done < "$devices"
+        [ "$has_connected" = 1 ] || printf 'Bluetooth\tConectado\t\tInfo\t[sin conectados]\tsh -c true\n'
+        [ "$has_paired" = 1 ] || printf 'Bluetooth\tEmparejados\t\tInfo\t[sin emparejados]\tsh -c true\n'
+        [ "$has_discovered" = 1 ] || printf 'Bluetooth\tBuscar dispositivos\t\tInfo\t[sin dispositivos]\tsh -c true\n'
+    else
+        printf 'Bluetooth\t\t\tInfo\t[BT] Sin dispositivos cerca (reintenta)\tsh -c '\''echo escanea con: bluetoothctl scan on'\''\n'
+    fi
+rm -f "$devices" "$btout" "$scanmacs"
+else
+    printf 'Bluetooth\t\t\tInfo\t[BT] instala bluez-utils (bluetoothctl)\tsh -c '\''echo instala: sudo pacman -S bluez bluez-utils'\''\n'
+fi
