new file mode 100755
index 0000000..bcab997
--- /dev/null
+++ b/tbwm-network
@@ -0,0 +1,105 @@
+#!/bin/sh
+# List WiFi networks and Bluetooth devices for tbwm's network menu.
+# Output: Category<TAB>Group<TAB>Name<TAB>shell-command[<TAB>needspass], one per line.
+# WiFi: detects the active network manager (connman or NetworkManager) so the
+#   menu works on both; needspass=1 means the network is protected, so tbwm
+#   prompts for a password.
+# Bluetooth: powered on + brief scan; connect/disconnect by MAC.
+
+# --- WiFi (category: Wifi) ---
+if pgrep -x connmand >/dev/null 2>&1; then
+    connmanctl enable wifi >/dev/null 2>&1
+    connmanctl scan wifi >/dev/null 2>&1
+
+    connmanctl services 2>/dev/null | while IFS= read -r line; do
+        [ -n "$line" ] || continue
+        id=$(printf '%s' "$line" | awk '{print $NF}')
+        [ -n "$id" ] || continue
+        rest=$(printf '%s' "$line" | sed "s/[[:space:]]*${id}[[:space:]]*$//")
+        case "$id" in
+            wifi_*_psk|wifi_*_wep) need=1;;
+            *) need=0;;
+        esac
+        case "$rest" in
+            *"*"*) group="Connected"; prefix="[WiFi*]"
+                   name=$(printf '%s' "$rest" | awk '{$1=""; sub(/^ +/,""); print}');;
+            *)     group="Connect"; prefix="[WiFi]"
+                   name=$(printf '%s' "$rest" | sed 's/^[[:space:]]*//');;
+        esac
+        [ -n "$name" ] || continue
+
+        nameq=$(printf '%s' "$name" | sed "s/'/'\\\\''/g")
+        if [ "$need" = "1" ]; then
+            # tbwm appends " password '<escaped>'" to this command, so in the
+            # inner sh: $1=<id> and $3=<password>.
+            exec="sh -c 'connmanctl config \"\$1\" --passphrase \"\$3\" --save && connmanctl connect \"\$1\"' _ $id"
+        else
+            exec="connmanctl connect $id"
+        fi
+        printf 'Wifi\t%s\t%s %s\t%s\t%s\n' "$group" "$prefix" "$name" "$exec" "$need"
+    done
+elif [ "$(nmcli -t -f RUNNING general status 2>/dev/null)" = "running" ]; then
+    saved="$(nmcli -t -f NAME connection show 2>/dev/null | sed 's/^/ /')"
+
+    nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | sort -r | while IFS=: read -r inuse ssid sig sec; do
+        [ -n "$ssid" ] || continue
+        need=0
+        case "$inuse" in
+            '*') group="Connected"; prefix="[WiFi*]";;
+            *)   group="Connect"; prefix="[WiFi]"
+                 if [ -n "$sec" ] && ! printf '%s\n' "$saved" | grep -qxF " $ssid"; then
+                     need=1
+                 fi
+                 ;;
+        esac
+        if printf '%s\n' "$seen" | grep -qxF "$ssid"; then
+            continue
+        fi
+        seen="$seen
+$ssid"
+        ssq=$(printf '%s' "$ssid" | sed "s/'/'\\\\''/g")
+        printf 'Wifi\t%s\t%s %s (%s%%)\tnmcli dev wifi connect '\''%s'\''\t%s\n' "$group" "$prefix" "$ssid" "$sig" "$ssq" "$need"
+    done
+else
+    printf 'Wifi\tInfo\t[WiFi] ni connman ni NetworkManager activos\tsh -c '\''echo activa: sudo sv up connmand (connman) o NetworkManager'\''\n'
+fi
+
+# --- Bluetooth (category: Bluetooth) ---
+if command -v bluetoothctl >/dev/null 2>&1; then
+    bluetoothctl power on >/dev/null 2>&1
+    # A longer scan so nearby devices get cached by bluetoothd (a 2s scan
+    # usually leaves the cache empty and the menu hides the whole category).
+    timeout 10 bluetoothctl scan on >/dev/null 2>&1 &
+    scan_pid=$!
+    sleep 8
+    kill "$scan_pid" 2>/dev/null
+    wait "$scan_pid" 2>/dev/null
+
+    connected="$(bluetoothctl devices Connected 2>/dev/null | sed -n 's/^Device //p')"
+    devices="$(bluetoothctl devices 2>/dev/null)"
+    if [ -n "$devices" ]; then
+        printf '%s\n' "$devices" | while read -r _ mac name; do
+            [ -n "$mac" ] || continue
+            name=$(printf '%s' "$name" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g')
+            [ -n "$name" ] || name="(sin nombre)"
+            if printf '%s\n' "$connected" | grep -qF "$mac"; then
+                action="bluetoothctl disconnect $mac"
+                group="Connected"
+                prefix="[BT*]"
+            else
+                # ';' instead of '&&': if the device is already paired, 'pair'
+                # fails and must not stop the connect.
+                action="bluetoothctl pair $mac; bluetoothctl trust $mac; bluetoothctl connect $mac"
+                group="Connect"
+                prefix="[BT]"
+            fi
+            printf 'Bluetooth\t%s\t%s %s\t%s\n' "$group" "$prefix" "$name" "$action"
+        done
+    else
+        # Always emit a fallback entry so the Bluetooth category never
+        # disappears from the menu.
+        printf 'Bluetooth\tInfo\t[BT] Sin dispositivos cerca (reintenta)\tsh -c '\''echo escanea con: bluetoothctl scan on'\''\n'
+    fi
+else
+    printf 'Bluetooth\tInfo\t[BT] instala bluez-utils (bluetoothctl)\tsh -c '\''echo instala: sudo pacman -S bluez bluez-utils'\''\n'
+fi
