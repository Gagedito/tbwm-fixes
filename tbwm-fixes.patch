+#!/bin/sh
+# tbwm-audio-menu — list audio controls and sinks/sources for tbwm's audio menu.
+# Output: Category<TAB>Group<TAB>Subgroup<TAB>Action<TAB>command, one per line.
+# Hierarchy: Category -> Group (fixed sub-topic) -> Subgroup (each sink/source)
+#           -> Action (Elegir/Subir/Bajar/Silenciar/Mutear).
+# The Volumen category carries status rows (4-column legacy lines, rendered as
+# read-only labels) plus the master volume actions. Every action keeps the
+# menu open: tbwm re-runs this script to refresh the values.
+#
+# Depends on wpctl (wireplumber/PipeWire). tbwm's audio menu command default:
+#   (set-audio-menu-cmd "tbwm-audio-menu")
+
+mode="${1:-all}"
+[ "$mode" = "all" ] || mode=all
+
+# Quote a string for use inside single quotes in a shell command.
+q() {
+    printf '%s' "$1" | sed "s/'/'\\\\''/g"
+}
+
+# Emit the Salidas/Entradas placeholders first so the categories and their
+# sub-topics exist from the very first render (no "Loading..." wait). They use
+# the legacy 4-column layout (category/group/name/exec) so they render as
+# read-only labels like the Volumen status row, and are hidden automatically
+# once real sinks/sources stream in as sub-topics.
+printf 'Salidas\tSalidas\t[sin salidas]\tsh -c true\n'
+printf 'Entradas\tEntradas\t[sin entradas]\tsh -c true\n'
+
+if ! command -v wpctl >/dev/null 2>&1; then
+    printf 'Volumen\tControles\t[falta wpctl: instala wireplumber]\tsh -c '\''echo instala: sudo pacman -S wireplumber'\''\n'
+    exit 0
+fi
+
+# Current master volume state (default sink) for the status row.
+gv=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
+pct=$(printf '%s\n' "$gv" | sed -n 's/^Volume: \([0-9.]*\).*/\1/p')
+[ -n "$pct" ] && pct=$(awk -v v="$pct" 'BEGIN{printf "%d", v*100}') || pct="?"
+case "$gv" in
+    *MUTED*) mutes=" | mudo";;
+    *) mutes="";;
+esac
+
+# Default microphone mute state for the indicator row.
+gsv=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
+case "$gsv" in
+    *MUTED*) micmute="mudo";;
+    *) micmute="activo";;
+esac
+
+# Parse wpctl status: id, default marker and friendly name for every sink and
+# source in the Audio section (the part before the Video section).
+ws=$(wpctl status 2>/dev/null)
+audio_part=$(printf '%s\n' "$ws" | sed '/Video/,$d')
+lines="$(mktemp)"
+printf '%s\n' "$audio_part" | awk '
+    /Sinks:/{sec="sink"; next}
+    /Sources:/{sec="src"; next}
+    /Filters:/{sec=""; next}
+    sec == "sink" || sec == "src" {
+        line=$0
+        sub(/^.*│/, "", line)
+        isdef=0
+        sub(/^[ \t]+/, "", line)
+        if (sub(/^\*/, "", line)) isdef=1
+        sub(/^[ \t]+/, "", line)
+        if (match(line, /^[0-9]+\./)) {
+            id=substr(line, 1, RLENGTH-1)
+            rest=substr(line, RLENGTH+1)
+            sub(/^[ \t]+/, "", rest)
+            pcti=""
+            if (rest ~ /\[vol: /) {
+                vv=rest
+                sub(/.*\[vol: /, "", vv)
+                sub(/\].*/, "", vv)
+                muted=(vv ~ /MUTED/)
+                gsub(/ MUTED/, "", vv)
+                pctv=int(vv*100+0.5)
+                pcti=sprintf("%d%s", pctv, muted ? " mudo" : "")
+                sub(/[ \t]*\[vol: .*$/, "", rest)
+            }
+            gsub(/[ \t]+$/, "", rest)
+            printf "%s|%d|%s|%s|%s\n", sec, isdef, id, rest, pcti
+        }
+    }
+' > "$lines"
+
+# First pass: remember the default sink name for the status row.
+defsinkname=""
+while IFS='|' read -r sec isdef id name pcti; do
+    [ "$sec" = "sink" ] && [ "$isdef" = "1" ] && [ -n "$name" ] && defsinkname=$name
+done < "$lines"
+
+# Volumen: status rows (read-only labels, one per value so each stays readable)
+# + master volume actions.
+printf 'Volumen\tControles\t[vol %s%%%s]\tsh -c true\n' "$pct" "$mutes"
+printf 'Volumen\tControles\t[salida: %s]\tsh -c true\n' "$defsinkname"
+printf 'Volumen\tControles\t[mic: %s]\tsh -c true\n' "$micmute"
+if [ "$pct" != "?" ]; then
+    printf 'Volumen\tControles\t\tSubir 5%%\twpctl set-volume @DEFAULT_AUDIO_SINK@ 5%%+\n'
+    printf 'Volumen\tControles\t\tBajar 5%%\twpctl set-volume @DEFAULT_AUDIO_SINK@ 5%%-\n'
+    printf 'Volumen\tControles\t\tSilenciar\twpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\n'
+fi
+printf 'Volumen\tControles\t\tMic silencio\twpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\n'
+
+# Salidas / Entradas: each sink/source is a sub-topic with its own actions.
+# Sub-topic names are kept stable (no live volume suffix) so tbwm can preserve
+# the user's position when it re-runs this script after an action.
+while IFS='|' read -r sec isdef id name pcti; do
+    [ -n "$id" ] || continue
+    [ -n "$name" ] || name="(sin nombre)"
+    star=""; [ "$isdef" = "1" ] && star="*"
+    nq=$(q "${star}${name}")
+    if [ "$sec" = "sink" ]; then
+        printf 'Salidas\tSalidas\t%s\tElegir\twpctl set-default %s\n' "$nq" "$id"
+        printf 'Salidas\tSalidas\t%s\tSubir\twpctl set-volume %s 5%%+\n' "$nq" "$id"
+        printf 'Salidas\tSalidas\t%s\tBajar\twpctl set-volume %s 5%%-\n' "$nq" "$id"
+        printf 'Salidas\tSalidas\t%s\tSilenciar\twpctl set-mute %s toggle\n' "$nq" "$id"
+    else
+        printf 'Entradas\tEntradas\t%s\tElegir\twpctl set-default %s\n' "$nq" "$id"
+        printf 'Entradas\tEntradas\t%s\tMutear\twpctl set-mute %s toggle\n' "$nq" "$id"
+        printf 'Entradas\tEntradas\t%s\tSubir\twpctl set-volume %s 5%%+\n' "$nq" "$id"
+        printf 'Entradas\tEntradas\t%s\tBajar\twpctl set-volume %s 5%%-\n' "$nq" "$id"
+    fi
+done < "$lines"
+rm -f "$lines"
+exit 0
diff --git a/tbwm-network b/tbwm-network
new file mode 100755
index 0000000..304e307
--- /dev/null
+++ b/tbwm-network
@@ -0,0 +1,370 @@
+#!/bin/sh
+# tbwm-network — ver. sincronizada con Gagedito/tbwm-network @ 9a7c8c7 (2026-08-10).
+# Si editás este archivo, replicá el cambio en los otros repos y regenerá el patch.
+# List WiFi networks and Bluetooth devices for tbwm's network menu.
+# Output: Category<TAB>Group<TAB>Subgroup<TAB>Action<TAB>command[<TAB>needspass], one per line.
+# Hierarchy: Category -> Group (fixed sub-topic) -> Subgroup (each network/device)
+#           -> Action (Conectar/Desconectar/Olvidar).
+# Empty groups get an "Info" placeholder so every sub-topic stays visible.
+# WiFi: detects the active network manager (connman or NetworkManager).
+# Bluetooth: powered on + brief scan; connect/disconnect/forget by MAC.
+#
+# Subcommands (the WM picks these when the menu is focused on a search
+# sub-topic so it only rescans the section the user is looking at):
+#   tbwm-network        list everything (WiFi + Bluetooth)
+#   tbwm-network wifi   only the WiFi category (fast, no BT scan)
+#   tbwm-network bt     only the Bluetooth category (brief scan)
+# A subcommand exits right after its section, so the WM gets a short,
+# focused stream it can render incrementally while scanning.
+
+mode="${1:-all}"
+[ "$mode" = "bt" ] || [ "$mode" = "wifi" ] || [ "$mode" = "all" ] || mode=all
+
+# Emit the WiFi group placeholders before anything else (except in "bt" mode)
+# so the Wifi category and its sub-topics exist from the very first render
+# (no "Loading..." wait) and stay first in the menu's category list. Real
+# entries stream in later and hide the placeholders. Skipped in "bt" mode,
+# which only lists the Bluetooth category.
+if [ "$mode" != "bt" ]; then
+    if pgrep -x connmand >/dev/null 2>&1; then
+        printf 'Wifi\tConectado\t\tInfo\t[sin red conectada]\tsh -c true\n'
+        printf 'Wifi\tGuardadas\t\tInfo\t[sin redes guardadas]\tsh -c true\n'
+    elif [ "$(nmcli -t -f RUNNING general status 2>/dev/null)" = "running" ]; then
+        printf 'Wifi\tConectado\t\tInfo\t[sin red conectada]\tsh -c true\n'
+        printf 'Wifi\tGuardadas\t\tInfo\t[sin redes guardadas]\tsh -c true\n'
+        printf 'Wifi\tBuscar red\t\tInfo\t[sin redes visibles]\tsh -c true\n'
+    fi
+fi
+
+# Then the Bluetooth group placeholders so both categories and all their
+# sub-topics exist from the first render. Skipped in "wifi" mode, which only
+# lists the WiFi category.
+if [ "$mode" != "wifi" ] && command -v bluetoothctl >/dev/null 2>&1; then
+    printf 'Bluetooth\tConectado\t\tInfo\t[sin conectados]\tsh -c true\n'
+    printf 'Bluetooth\tEmparejados\t\tInfo\t[sin emparejados]\tsh -c true\n'
+    printf 'Bluetooth\tBuscar dispositivos\t\tInfo\t[sin dispositivos]\tsh -c true\n'
+fi
+
+# Quote a string for use inside single quotes in a shell command.
+q() {
+    printf '%s' "$1" | sed "s/'/'\\\\''/g"
+}
+
+# --- WiFi (category: Wifi) ---
+if [ "$mode" != "bt" ]; then
+if pgrep -x connmand >/dev/null 2>&1; then
+    connmanctl enable wifi >/dev/null 2>&1
+    connmanctl scan wifi >/dev/null 2>&1
+
+    services="$(mktemp)"
+    connmanctl services 2>/dev/null > "$services"
+    has_conn=0
+    has_saved=0
+    has_search=0
+    while IFS= read -r line; do
+        [ -n "$line" ] || continue
+        id=$(printf '%s' "$line" | awk '{print $NF}')
+        [ -n "$id" ] || continue
+        rest=$(printf '%s' "$line" | sed "s/[[:space:]]*${id}[[:space:]]*$//")
+        case "$id" in
+            wifi_*_psk|wifi_*_wep) need=1;;
+            *) need=0;;
+        esac
+        case "$rest" in
+            *"*"*) conn=1
+                   name=$(printf '%s' "$rest" | awk '{$1=""; sub(/^ +/,""); print}');;
+            *)     conn=0
+                   name=$(printf '%s' "$rest" | sed 's/^[[:space:]]*//');;
+        esac
+        [ -n "$name" ] || continue
+
+        nameq=$(q "$name")
+        if [ "$conn" = "1" ]; then
+            has_conn=1
+            printf 'Wifi\tConectado\t%s\tDesconectar\tconnmanctl disconnect %s\n' "$nameq" "$id"
+            printf 'Wifi\tConectado\t%s\tOlvidar\tconnmanctl remove %s\n' "$nameq" "$id"
+        else
+            has_saved=1
+            printf 'Wifi\tGuardadas\t%s\tConectar\t' "$nameq"
+            if [ "$need" = "1" ]; then
+                exec_ps="sh -c 'connmanctl config \"\$1\" --passphrase \"\$3\" --save && connmanctl connect \"\$1\"' _ $id"
+                printf '%s\t1\n' "$exec_ps"
+            else
+                printf 'connmanctl connect %s\n' "$id"
+            fi
+            printf 'Wifi\tGuardadas\t%s\tOlvidar\tconnmanctl remove %s\n' "$nameq" "$id"
+        fi
+    done < "$services"
+    rm -f "$services"
+elif [ "$(nmcli -t -f RUNNING general status 2>/dev/null)" = "running" ]; then
+    savedw=""
+    while IFS=: read -r prof type; do
+        [ "$type" = "802-11-wireless" ] || continue
+        [ -n "$prof" ] || continue
+        savedw="$savedw
+$prof"
+    done <<EOF
+$(nmcli -t -f NAME,TYPE connection show 2>/dev/null)
+EOF
+    active="$(nmcli -t -f NAME connection show --active 2>/dev/null)"
+
+    # Signal strength map (SSID -> %) for the connected network
+    signals=""
+    while IFS=: read -r inuse ssid sig sec; do
+        [ -n "$ssid" ] || continue
+        signals="$signals
+$ssid=$sig"
+    done <<EOF
+$(nmcli -t -f IN-USE,SSID,SIGNAL dev wifi list 2>/dev/null)
+EOF
+
+    # 1) Connected
+    has_conn=0
+    while IFS= read -r prof; do
+        [ -n "$prof" ] || continue
+        if printf '%s\n' "$active" | grep -qxF "$prof"; then
+            has_conn=1
+            pq=$(q "$prof")
+            sig=$(printf '%s\n' "$signals" | awk -F= -v n="$prof" '$1==n{print $2; exit}')
+            if [ -n "$sig" ]; then
+                sq=$(q "$prof ($sig%)")
+            else
+                sq=$pq
+            fi
+            printf 'Wifi\tConectado\t%s\tDesconectar\tnmcli connection down '\''%s'\''\n' "$sq" "$pq"
+            printf 'Wifi\tConectado\t%s\tOlvidar\tnmcli connection delete '\''%s'\''\n' "$sq" "$pq"
+        fi
+    done <<EOF
+$savedw
+EOF
+
+    # 2) Saved networks (each one its own subgroup)
+    has_saved=0
+    while IFS= read -r prof; do
+        [ -n "$prof" ] || continue
+        if ! printf '%s\n' "$active" | grep -qxF "$prof"; then
+            has_saved=1
+            pq=$(q "$prof")
+            printf 'Wifi\tGuardadas\t%s\tConectar\tnmcli connection up '\''%s'\''\n' "$pq" "$pq"
+            printf 'Wifi\tGuardadas\t%s\tOlvidar\tnmcli connection delete '\''%s'\''\n' "$pq" "$pq"
+        fi
+    done <<EOF
+$savedw
+EOF
+
+    # 3) Search: available, not saved. Trigger a fresh scan and wait for
+    # results first (without it nmcli returns the stale cache and "Buscar red"
+    # only shows a handful of networks). This runs after Conectado/Guardadas
+    # streamed from the cache, so it never blocks the first render.
+    nmcli dev wifi rescan >/dev/null 2>&1
+    nscan=0
+    while [ "$nscan" -lt 20 ]; do
+        n=$(nmcli -t -f SSID dev wifi list 2>/dev/null | grep -c .)
+        [ "$n" -ge 3 ] && break
+        sleep 1
+        nscan=$((nscan + 1))
+    done
+
+    has_search=0
+    seen="$savedw"
+    while IFS=: read -r inuse ssid sig sec; do
+        [ -n "$ssid" ] || continue
+        if printf '%s\n' "$seen" | grep -qxF "$ssid"; then
+            continue
+        fi
+        seen="$seen
+$ssid"
+        has_search=1
+        ssq=$(q "$ssid")
+        need=0
+        [ -n "$sec" ] && need=1
+        printf 'Wifi\tBuscar red\t%s (%s%%)\tConectar\tnmcli dev wifi connect '\''%s'\''\t%s\n' "$ssq" "$sig" "$ssq" "$need"
+    done <<EOF
+$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | sort -r)
+EOF
+else
+    printf 'Wifi\t\t\tInfo\t[WiFi] ni connman ni NetworkManager activos\tsh -c '\''echo activa: sudo sv up connmand (connman) o NetworkManager'\''\n'
+fi
+fi
+
+# --- Bluetooth (category: Bluetooth) ---
+if [ "$mode" != "wifi" ] && command -v bluetoothctl >/dev/null 2>&1; then
+    # Some laptops (e.g. Lenovo ideapad) leave the radio soft-blocked via
+    # rfkill, which makes "power on" fail with org.bluez.Error.Failed and the
+    # scan with "NotReady". Unblock first so the menu can actually scan. No
+    # privileges needed for the user's own rfkill entries.
+    rfkill unblock bluetooth 2>/dev/null
+    sleep 0.5
+    bluetoothctl power on >/dev/null 2>&1
+    btout="$(mktemp)"
+    paired="$(bluetoothctl devices Paired 2>/dev/null)"
+    connected="$(bluetoothctl devices Connected 2>/dev/null)"
+    devices="$(mktemp)"
+    scanmacs="$(mktemp)"
+    emitted="$(mktemp)"
+    bluetoothctl devices 2>/dev/null > "$devices"
+
+    # Keep the scan alive while we inspect devices below: bluetoothctl info
+    # only reports RSSI while a discovery is running. Devices the daemon
+    # merely remembers but are NOT in range anymore never get a fresh RSSI.
+    # bluetoothctl reads commands from stdin, so a bare "scan on" launched from
+    # a menu (stdin at EOF) would start the scan and exit immediately, never
+    # really discovering anything. Feed the commands through a pipe so the
+    # session stays alive for the whole discovery window. In "bt" mode (the
+    # live "Buscar dispositivos" view) keep the window short so results stream
+    # in quickly; in "all" mode use a longer one since this is the one-shot
+    # initial load.
+    if [ "$mode" = "bt" ]; then
+        ( echo "scan on"; sleep 8; echo "scan off" ) | bluetoothctl > "$btout" 2>&1 &
+    else
+        ( echo "scan on"; sleep 16; echo "scan off" ) | bluetoothctl > "$btout" 2>&1 &
+    fi
+
+    # Controller D-Bus root, used to read the live RSSI of each known device
+    # below. The daemon updates RSSI while discovery is running, so a non-empty
+    # value means "this device was seen in the current scan". Stale remembered
+    # devices that are no longer in range keep no RSSI, so they drop out of
+    # "Buscar dispositivos" automatically.
+    btroot=""
+    if command -v busctl >/dev/null 2>&1; then
+        btroot="$(busctl --system tree org.bluez 2>/dev/null | grep -oE '/org/bluez/hci[0-9]+' | sort -u | head -1)"
+    fi
+
+    # Merge newly discovered devices (from the scan output) into the list so
+    # "Buscar dispositivos" shows devices found during this scan, not only the
+    # ones the daemon already remembered. The scan emits "[NEW] Device
+    # AA:BB:.. NAME" for devices seen for the first time and "[CHG] Device
+    # AA:BB:.. RSSI: ..." for updates to known ones — both prove the device was
+    # seen in the current scan.
+    merge_scan() {
+        [ -s "$btout" ] || return 0
+        while IFS= read -r line; do
+            [ -n "$line" ] || continue
+            case "$line" in
+                *"NEW] Device "*|*"[NEW] Device"*|*"CHG] Device "*|*"[CHG] Device"*|Device\ *) ;;
+                *) continue;;
+            esac
+            mac=$(printf '%s\n' "$line" | sed -n 's/.*Device \(\([0-9A-Fa-f][0-9A-Fa-f]:\)\{5\}[0-9A-Fa-f][0-9A-Fa-f]\).*/\1/p')
+            [ -n "$mac" ] || continue
+            if ! grep -qxF "$mac" "$scanmacs"; then
+                printf '%s\n' "$mac" >> "$scanmacs"
+            fi
+            if ! grep -q " $mac " "$devices"; then
+                name=$(printf '%s\n' "$line" | sed -n "s/.*Device $mac[^ ]* \([^[:cntrl:]]*\).*/\1/p")
+                name=$(printf '%s' "$name" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g')
+                printf 'Device %s %s\n' "$mac" "$name" >> "$devices"
+            fi
+        done < "$btout"
+    }
+
+    # A device counts as in range either if the scan output mentioned it
+    # ([NEW]/[CHG]) or if the daemon reports a live RSSI for it right now
+    # (bluetoothctl does not always emit [CHG] lines for known devices even
+    # though the daemon is picking them up).
+    device_in_range() {
+        mac="$1"
+        if grep -qxF "$mac" "$scanmacs"; then
+            return 0
+        fi
+        if [ -n "$btroot" ]; then
+            devpath="${btroot}/dev_$(printf '%s' "$mac" | tr ':' '_')"
+            rssi=$(busctl --system get-property org.bluez "$devpath" org.bluez.Device1 RSSI 2>/dev/null | sed -n 's/^n //p')
+            [ -n "$rssi" ] && return 0
+        fi
+        return 1
+    }
+
+    # Emit a "Buscar dispositivos" line for every in-range, unpaired,
+    # unconnected device not yet printed (tracked in "$emitted" so each one
+    # appears exactly once as the scan streams in).
+    emit_discovered() {
+        if [ -s "$devices" ]; then
+            while IFS= read -r line; do
+                [ -n "$line" ] || continue
+                set -- $line
+                [ "$1" = "Device" ] || continue
+                [ $# -ge 3 ] || continue
+                mac=$2
+                case "$mac" in
+                    [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
+                    *) continue;;
+                esac
+                if printf '%s\n' "$connected" | grep -qF "$mac"; then continue; fi
+                if printf '%s\n' "$paired" | grep -qF "$mac"; then continue; fi
+                if grep -qxF "$mac" "$emitted"; then continue; fi
+                if device_in_range "$mac"; then
+                    name=$(printf '%s' "$line" | sed "s/^Device $mac //" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g' | sed -r 's/[[:space:]]*\([0-9]+\)$//')
+                    case "$name" in
+                        *RSSI:*|*\[CHG\]*|Device*) name="";;
+                    esac
+                    [ -n "$name" ] || name="(sin nombre)"
+                    printf '%s\n' "$mac" >> "$emitted"
+                    has_discovered=1
+                    nq=$(q "$name")
+                    printf 'Bluetooth\tBuscar dispositivos\t%s\tConectar\t%s\tBTPAIR\n' "$nq" "$mac"
+                fi
+            done < "$devices"
+        fi
+    }
+
+    has_connected=0
+    has_paired=0
+    has_discovered=0
+    if [ -s "$devices" ]; then
+        # Conectado/Emparejados come straight from the daemon cache, so emit
+        # them right away while the scan is still warming up.
+        seen=""
+        while IFS= read -r line; do
+            [ -n "$line" ] || continue
+            set -- $line
+            [ "$1" = "Device" ] || continue
+            [ $# -ge 3 ] || continue
+            mac=$2
+            case "$mac" in
+                [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
+                *) continue;;
+            esac
+            name=$(printf '%s' "$line" | sed "s/^Device $mac //" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g' | sed -r 's/[[:space:]]*\([0-9]+\)$//')
+            case "$name" in
+                *RSSI:*|*\[CHG\]*|Device*) name="";;
+            esac
+            [ -n "$name" ] || name="(sin nombre)"
+            if printf '%s\n' "$seen" | grep -qF "$mac"; then
+                continue
+            fi
+            seen="$seen
+$mac"
+            nq=$(q "$name")
+            if printf '%s\n' "$connected" | grep -qF "$mac"; then
+                has_connected=1
+                printf 'Bluetooth\tConectado\t%s\tDesconectar\tbluetoothctl disconnect %s\n' "$nq" "$mac"
+                printf 'Bluetooth\tConectado\t%s\tOlvidar\tbluetoothctl remove %s\n' "$nq" "$mac"
+            elif printf '%s\n' "$paired" | grep -qF "$mac"; then
+                has_paired=1
+                printf 'Bluetooth\tEmparejados\t%s\tConectar\tbluetoothctl connect %s\n' "$nq" "$mac"
+                printf 'Bluetooth\tEmparejados\t%s\tOlvidar\tbluetoothctl remove %s\n' "$nq" "$mac"
+            fi
+        done < "$devices"
+    fi
+
+    # Stream the scan: in "bt" mode (the live "Buscar dispositivos" view) poll
+    # the scan output every second and emit each newly found device as it shows
+    # up, so the menu grows item by item. In "all" mode this is the one-shot
+    # initial load, so just wait out the window and emit everything at once.
+    if [ "$mode" = "bt" ]; then
+        i=0
+        while [ "$i" -lt 7 ]; do
+            sleep 1
+            merge_scan
+            emit_discovered
+            i=$((i+1))
+        done
+    else
+        sleep 13
+        merge_scan
+        emit_discovered
+    fi
+rm -f "$devices" "$btout" "$scanmacs" "$emitted"
+else
