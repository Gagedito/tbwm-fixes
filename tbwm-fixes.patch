+/* Scheme function: (view-tag n) - switch to tag n (1-9) */
+static s7_pointer scm_view_tag(s7_scheme *sc, s7_pointer args)
+{
+	Arg arg;
+	int n;
+	if (!s7_is_integer(s7_car(args)))
+		return s7_f(sc);
+	n = s7_integer(s7_car(args));
+	if (n < 1 || n > 9)
+		return s7_f(sc);
+	arg.ui = 1 << (n - 1);
+	view(&arg);
+	return s7_t(sc);
+}
