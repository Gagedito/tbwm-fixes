+/* Network menu (WiFi / Bluetooth): a flat text list fed by netmenu_cmd */
+static void
+updatenetmenu(void)
+{
+	struct TitleBuffer *tb;
+	uint32_t *pixels;
+	int menu_cells_w = 25;
+	int menu_cells_h = 25;
+	int menu_width = menu_cells_w * cell_width;
