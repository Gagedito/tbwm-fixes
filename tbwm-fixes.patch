+
+	/* Fill entire background with content color first */
+	for (i = 0; i < menu_width * menu_height; i++) {
+		pixels[i] = content_bg;
+	}
+
+	/* Draw frame background for border cells */
+	for (y = 0; y < cell_height; y++) {
+		for (x = 0; x < menu_width; x++) {
+			pixels[y * menu_width + x] = frame_bg;
+		}
